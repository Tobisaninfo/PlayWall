<?xml version="1.0" encoding="UTF-8"?>

<?import de.tobias.playwall.client.view.components.settings.SettingsRow?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ComboBox?>
<VBox spacing="14.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <SettingsRow icon="GEAR_SOLID" title="%ui.action.global.volume.mode">
        <ComboBox fx:id="modeComboBox"/>
    </SettingsRow>
    <SettingsRow icon="PERCENT_SOLID" title="%ui.action.global.volume.delta">
        <ComboBox fx:id="deltaComboBox"/>
    </SettingsRow>

    <VBox fx:id="feedbackValueContainer" spacing="14"/>
</VBox>
