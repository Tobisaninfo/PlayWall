<?xml version="1.0" encoding="UTF-8"?>

<?import de.tobias.playwall.client.view.components.settings.SettingsPage?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import de.tobias.playwall.client.view.components.PlayWallButton?>
<SettingsPage fx:id="settingsPage" maxHeight="1.7976931348623157E308" VBox.vgrow="ALWAYS"
              xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">

    <Separator/>
    <HBox spacing="7" maxHeight="1.7976931348623157E308" VBox.vgrow="ALWAYS" prefWidth="200.0">
        <children>
            <VBox spacing="7">
                <children>
                    <ListView fx:id="mappingListView" maxHeight="1.7976931348623157E308" VBox.vgrow="ALWAYS"
                              prefWidth="150.0"/>

                    <HBox spacing="7">
                        <children>
                            <PlayWallButton fx:id="keyboardAddButton" onAction="#onKeyboardAdd" icon="PLUS_SOLID"
                                            text="Tastatur" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308"/>
                            <PlayWallButton fx:id="midiAddButton" onAction="#onMidiAdd" icon="PLUS_SOLID" text="MIDI"
                                            HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308"/>
                        </children>
                    </HBox>
                </children>
            </VBox>
            <Separator orientation="VERTICAL" prefHeight="200.0"/>
            <TabPane fx:id="actionTabs"
                     maxHeight="1.7976931348623157E308" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                     tabClosingPolicy="UNAVAILABLE">
            </TabPane>
        </children>
    </HBox>
</SettingsPage>
