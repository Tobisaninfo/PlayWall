<?xml version="1.0" encoding="UTF-8"?>

<?import de.tobias.playwall.client.view.components.PlayWallButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="14.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
    </padding>
    <VBox alignment="CENTER" spacing="14.0" VBox.vgrow="ALWAYS">
        <Label fx:id="keyLabel" styleClass="key-input-placeholder" text="%ui.dialog.keyboard.input.placeholder" />
        <Label fx:id="errorLabel" styleClass="error-label" text="%ui.dialog.keyboard.input.error.duplicate" visible="false" />
    </VBox>
    <HBox alignment="CENTER" spacing="14.0">
        <PlayWallButton fx:id="cancelButton" icon="XMARK_SOLID" onAction="#cancelHandler" text="%ui.settings.button.cancel" />
        <PlayWallButton fx:id="saveButton" defaultButton="true" icon="FLOPPY_DISK_SOLID" onAction="#submitHandler" text="%ui.settings.button.save" />
    </HBox>
</VBox>
