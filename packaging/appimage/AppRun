#!/bin/sh
# AppImage entry point. The jpackage launcher resolves its runtime and app libs relative to its own
# location, so it works unchanged from inside the read-only AppImage mount.
HERE="$(dirname "$(readlink -f "$0")")"

# UI scale: glass.gtk.uiScale only takes effect as a real JVM argument at process start. Normally the
# client writes it into lib/app/PlayWall.cfg, but that file is read-only inside an AppImage. The client
# therefore stores the percentage in this file (see ProgramSettingsGeneralViewController.appImageScaleFile),
# and we pass it to the JVM via JAVA_TOOL_OPTIONS. Path and format must match the client.
SCALE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/PlayWall/appimage-ui-scale"
if [ -r "$SCALE_FILE" ]; then
  SCALE="$(tr -d '[:space:]' < "$SCALE_FILE")"
  case "$SCALE" in
    ''|*[!0-9]*) ;;  # ignore anything that is not a plain number
    *) export JAVA_TOOL_OPTIONS="-Dglass.gtk.uiScale=${SCALE}% ${JAVA_TOOL_OPTIONS:-}" ;;
  esac
fi

exec "$HERE/usr/PlayWall/bin/PlayWall" "$@"
