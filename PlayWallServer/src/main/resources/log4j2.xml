<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">

    <Appenders>

        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout>
                <!-- @formatter:off-->
                <Pattern>%highlight{[%-5level]}{
                    FATAL=red blink,
                    ERROR=red bold,
                    WARN=yellow bold,
                    INFO=green,
                    DEBUG=cyan,
                    TRACE=white} %style{%d{HH:mm:ss:SSSS}}{blue} @ %style{[%t]}{white} @ %style{[%c{1.}.%M:%L]}{cyan}: %msg%n
                </Pattern>
                <!-- @formatter:on-->
            </PatternLayout>
        </Console>

        <RollingFile name="FileAppender"
                     fileName="${sys:app.logdir}/server.log"
                     filePattern="${sys:app.logdir}/server-%d{yyyy-MM-dd}.log.gz">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5level [%t] @ [%c{1.}.%M:%L]: %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/>
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
            <DefaultRolloverStrategy max="30"/>
        </RollingFile>

        <RemoteLogViewerAppender
                name="Remote"
                host="localhost"
                port="4712"
                appName="PlayWallServer">
        </RemoteLogViewerAppender>

        <Async name="ConsoleAndRemote" includeLocation="true">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="Remote"/>
        </Async>

        <Async name="ConsoleAndFileAndRemote" includeLocation="true">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
            <AppenderRef ref="Remote"/>
        </Async>

        <Routing name="Routing">
            <Routes pattern="${sys:app.debug:-false}">
                <Route key="true" ref="ConsoleAndRemote"/>
                <Route key="false" ref="ConsoleAndFileAndRemote"/>
            </Routes>
        </Routing>

    </Appenders>

    <Loggers>
        <Root level="info">
            <AppenderRef ref="Routing">
                <MarkerFilter marker="PadPlayPositionUpdate"
                              onMatch="DENY"
                              onMismatch="NEUTRAL"/>
            </AppenderRef>
        </Root>
    </Loggers>

</Configuration>